def original_cohort_users(raw_counts: pd.DataFrame, minimum=20, max_students=12000):
    eligible=raw_counts[raw_counts.interaction_count>=minimum].copy()
    eligible["activity_bin"]=pd.qcut(eligible.interaction_count.rank(method="first"),5,labels=["very_low","low","medium","high","very_high"])
    # reproduce original pandas-hash cohort exactly in the stated environment
    eligible["hash"]=pd.util.hash_pandas_object(eligible.UserId.astype(str)+"cohort",index=False).astype("uint64")
    selected=[]
    for _,g in eligible.groupby("activity_bin",observed=True):
        g=g.sort_values("hash"); chosen=g[g.interaction_count.cumsum()<=90000].head(max_students//5)
        if chosen.empty: chosen=g.head(1)
        selected.append(chosen)
    return pd.concat(selected,ignore_index=True)

def stable_hash_cohort_users(raw_counts,n_users,salt):
