         "Prevalence":weighted_mean(y,weights),"ROC_AUC":roc_auc_score(y,p,sample_weight=weights) if len(np.unique(y))>1 else np.nan,
         "PR_AUC_AP":average_precision_score(y,p,sample_weight=weights) if len(np.unique(y))>1 else np.nan,
         "Log_Loss":log_loss(y,p,labels=[0,1],sample_weight=weights),
         "Brier_Score":float(np.average((p-y)**2,weights=weights)),
         "ECE15":ece_score(y,p,15,weights,"uniform"),"ECE10":ece_score(y,p,10,weights,"uniform"),
         "ECE20":ece_score(y,p,20,weights,"uniform"),"ECE15_Quantile":ece_score(y,p,15,weights,"quantile"),
         "Calibration_Intercept":ci,"Calibration_Slope":cs,
         "Accuracy":accuracy_score(y,z,sample_weight=weights),"Balanced_Accuracy":balanced_accuracy_score(y,z,sample_weight=weights),
         "Precision":precision_score(y,z,sample_weight=weights,zero_division=0),"Recall":recall_score(y,z,sample_weight=weights,zero_division=0),
         "Specificity":tn/max(tn+fp,1),"F1":f1_score(y,z,sample_weight=weights,zero_division=0),
         "MCC":matthews_corrcoef(y,z,sample_weight=weights) if weights is None else np.nan,
         "TP":tp,"FP":fp,"TN":tn,"FN":fn}
    return out

def equal_student_weights(users):
    s=pd.Series(users); counts=s.value_counts(); return s.map(lambda u:1.0/counts.loc[u]).to_numpy(float)

def hgb(max_iter):
    return Pipeline([("imp",SimpleImputer(strategy="median",add_indicator=True)),
                     ("clf",HistGradientBoostingClassifier(max_iter=max_iter,learning_rate=.1,max_leaf_nodes=31,min_samples_leaf=20,l2_regularization=2,random_state=SEED))])

def fit_platt(logits_or_prob,y):
    p=safe_p(logits_or_prob); lr=LogisticRegression(C=1000,max_iter=500,solver="lbfgs")
    lr.fit(logit(p).reshape(-1,1),np.asarray(y,int)); return lr

def apply_platt(cal,p): return expit(cal.intercept_[0]+cal.coef_[0,0]*logit(safe_p(p)))

def select_calibrator(y,p):
    y=np.asarray(y,int); p=safe_p(p)
    candidates=[]
    # no calibration
    candidates.append(("none",None,p))
    # Platt
    pl=fit_platt(p,y); candidates.append(("platt",pl,apply_platt(pl,p)))
    # temperature-only logistic slope (zero intercept) by scalar optimization grid
    zz=logit(p); temps=np.geomspace(.35,3.0,81)
    losses=[]
    for t in temps: losses.append(log_loss(y,expit(zz/t),labels=[0,1]))
    t=float(temps[int(np.argmin(losses))]); candidates.append(("temperature",t,expit(zz/t)))
    rows=[]
    for name,obj,pp in candidates:
        rows.append({"name":name,"ROC_AUC":roc_auc_score(y,pp),"Log_Loss":log_loss(y,safe_p(pp)),"Brier":brier_score_loss(y,pp),"ECE15":ece_score(y,pp,15)})
    tab=pd.DataFrame(rows)
    mx=tab.ROC_AUC.max(); keep=tab[tab.ROC_AUC>=mx-.0002].sort_values(["Log_Loss","Brier","ECE15"])
    name=keep.iloc[0]["name"]
    chosen=[x for x in candidates if x[0]==name][0]
    return chosen[0],chosen[1],tab

def apply_calibrator(name,obj,p):
    p=safe_p(p)
    if name=="platt": return apply_platt(obj,p)
    if name=="temperature": return expit(logit(p)/float(obj))
    return p

