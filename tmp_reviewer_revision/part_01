def load_selected_answer_meta(answer_path, answer_ids, chunksize=1_000_000):
    ids=set(map(int,answer_ids)); parts=[]
    for chunk in pd.read_csv(answer_path,chunksize=chunksize,low_memory=False):
        x=pd.to_numeric(chunk["AnswerId"],errors="coerce")
        m=x.isin(ids)
        if m.any():
            p=chunk.loc[m].copy(); p["AnswerId"]=x.loc[m].astype("int64"); parts.append(p)
    out=pd.concat(parts,ignore_index=True); out=out.drop_duplicates("AnswerId",keep="last")
    return out

def enrich_cohort(rows,answer_meta,student_meta,question_meta,subject_meta):
    d=rows.merge(answer_meta,on="AnswerId",how="left",validate="one_to_one")
    d["DateAnswered"]=pd.to_datetime(d["DateAnswered"],errors="coerce",utc=True)
    sm=subject_meta.copy(); sm["SubjectId"]=pd.to_numeric(sm.SubjectId,errors="coerce").astype("Int64"); sm["ParentId"]=pd.to_numeric(sm.ParentId,errors="coerce").astype("Int64")
    level=sm.set_index("SubjectId").Level.to_dict(); parent=sm.dropna(subset=["ParentId"]).set_index("SubjectId").ParentId.astype(int).to_dict(); names=sm.set_index("SubjectId").Name.to_dict()
    qm=question_meta.copy(); qm["subject_ids"]=qm.SubjectId.map(parse_subjects); qm["number_of_subjects"]=qm.subject_ids.map(len)
    qm["primary_subject_id"]=qm.subject_ids.map(lambda xs:max(xs,key=lambda x:(level.get(x,-1),x)) if xs else -1)
    qm["subject_depth"]=qm.primary_subject_id.map(lambda x:level.get(x,-1)); qm["parent_subject_id"]=qm.primary_subject_id.map(lambda x:parent.get(x,-1)); qm["primary_subject_name"]=qm.primary_subject_id.map(lambda x:names.get(x,"Unknown"))
    d=d.merge(qm[["QuestionId","number_of_subjects","primary_subject_id","subject_depth","parent_subject_id","primary_subject_name"]],on="QuestionId",how="left",validate="many_to_one")
    d=d.merge(student_meta,on="UserId",how="left",validate="many_to_one")
    return d,parent,names

